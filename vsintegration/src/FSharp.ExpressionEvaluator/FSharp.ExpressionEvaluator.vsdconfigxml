<?xml version="1.0" encoding="utf-8"?>
<!--
    Copyright (c) Microsoft Corporation.  All Rights Reserved.  See License.txt in the project root for license information.

    Registers the F# expression compiler with the Concord debug engine. The LanguageId filter is the
    F# language GUID the compiler writes into PDBs (CompilerEnvironment.GetDebuggerLanguageID), so
    this component wins over Roslyn's C# compiler, which is registered as an unfiltered low-priority
    fallback. Format: https://github.com/Microsoft/ConcordExtensibilitySamples/wiki/Component-discovery-and-configuration
-->
<Configuration xmlns="http://schemas.microsoft.com/vstudio/vsdconfig/2008">

  <DefineGuid Name="FSharpExpressionCompilerId" Value="1919A951-F185-4316-8EBD-747C671AA71B"/>
  <DefineGuid Name="FSharpLanguageId" Value="AB4F38C9-B6E6-43BA-BE3B-58080B2CCCE3"/>

  <ManagedComponent
    ComponentId="FSharpExpressionCompilerId"
    ComponentLevel="9991900"
    AssemblyName="FSharp.ExpressionEvaluator"
    Synchronized="true">

    <Class Name="Microsoft.VisualStudio.FSharp.ExpressionEvaluator.FSharpExpressionCompiler">
      <Implements>
        <InterfaceGroup>
          <Filter>
            <LanguageId RequiredValue="FSharpLanguageId"/>
          </Filter>
          <Interface Name="IDkmClrExpressionCompiler"/>
        </InterfaceGroup>
      </Implements>
    </Class>

  </ManagedComponent>

</Configuration>
